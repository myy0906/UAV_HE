<?xml version="1.0"?>
<package format="3">

  <name>uav_vln_navigation</name>
  <version>0.1.0</version>

  <description>
    Obstacle-aware A-star navigation for UAV-VLN.
  </description>

  <maintainer email="uavhe2@example.com">
    uavhe2
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>uav_vln_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>

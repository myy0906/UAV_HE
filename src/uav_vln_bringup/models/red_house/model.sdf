<?xml version="1.0"?>
<sdf version="1.9">
  <model name="red_house">
    <static>true</static>

    <!-- Main building body -->
    <link name="house_body">
      <pose>0 0 1.5 0 0 0</pose>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>4.0 4.0 3.0</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>4.0 4.0 3.0</size>
          </box>
        </geometry>

        <material>
          <ambient>0.8 0.03 0.03 1</ambient>
          <diffuse>0.9 0.03 0.03 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- Roof -->
    <link name="roof">
      <pose>0 0 3.25 0 0 0</pose>

      <collision name="roof_collision">
        <geometry>
          <box>
            <size>4.5 4.5 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="roof_visual">
        <geometry>
          <box>
            <size>4.5 4.5 0.5</size>
          </box>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>

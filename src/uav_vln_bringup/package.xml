<?xml version="1.0"?>
<package format="3">

  <name>uav_vln_bringup</name>
  <version>0.1.0</version>

  <description>
    Full UAV-VLN system bringup.
  </description>

  <maintainer email="uavhe2@example.com">
    uavhe2
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>
    ament_python
  </buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <exec_depend>uav_vln_px4</exec_depend>
  <exec_depend>uav_vln_perception</exec_depend>
  <exec_depend>uav_vln_mapping</exec_depend>
  <exec_depend>uav_vln_navigation</exec_depend>
  <exec_depend>uav_vln_llm</exec_depend>
  <exec_depend>uav_vln_mission</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
